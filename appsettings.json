{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Processing": {
    "StoragePath": "artifacts/jobs",
    "TesseractPath": "tesseract",
    "PopplerPath": "pdftoppm",
    "ProcessTimeoutSeconds": 60,
    "JobTimeoutSeconds": 600,
    "QueueCapacity": 100,
    "MaxStoredJobs": 10000
  }
}
